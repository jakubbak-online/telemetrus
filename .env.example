# Skopiuj ten plik do .env (który jest w .gitignore) i podstaw własną wartość.
# Używane przez docker-compose.yml do:
#   1) zainicjowania tokena admina InfluxDB (usługa influxdb),
#   2) automatycznego wstrzyknięcia tego samego tokena do TelemetryWorker (InfluxDB__Token),
#      gdy uruchamiasz cały stack przez `docker compose up -d --build` — nic nie trzeba wklejać ręcznie.
# Wygenerować można np.: openssl rand -base64 64
#
# Tryb hybrydowy (TelemetryWorker uruchamiany lokalnie przez `dotnet run`, nie w Dockerze):
# wklej tę samą wartość ręcznie do TelemetryWorker/appsettings.Development.json pod InfluxDB:Token
# — patrz sekcja "Local Configuration" / "Konfiguracja lokalna" w README.

INFLUXDB_ADMIN_TOKEN=wygeneruj-wlasny-token-i-wpisz-tutaj
