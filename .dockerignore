# Note: docker-compose.yml builds each service with its own subfolder as the
# build context (e.g. context: ./FrontApi), so Docker only honors a
# .dockerignore placed inside that subfolder — this root-level file is NOT
# picked up for those builds. Each service directory has its own copy
# (FrontApi/.dockerignore, TelemetryWorker/.dockerignore,
# NotificationWebApp/.dockerignore); keep them in sync with this one.
**/bin/
**/obj/
**/.vs/
**/.vscode/
**/.idea/
**/*.user
.git/
.env
